# Copy to .env and adjust for this Mac. Every value is optional.

# Port the DevLaunch app listens on.
DEVLAUNCH_PORT=3000

# 127.0.0.1 = this Mac only (default). 0.0.0.0 = also reachable from your phone on the same network
# (Settings → On your phone toggles this and restarts the service).
# DEVLAUNCH_BIND=127.0.0.1

# Where the SQLite database and SSH keys live. Defaults to ./data (git-ignored).
# DEVLAUNCH_DATA_DIR=/Users/you/projects/devlaunch/data
