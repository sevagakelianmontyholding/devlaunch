# Copy this file to .env and adjust the values for the current Mac.

# Docker / Nginx Proxy Manager
DEVLAUNCH_NPM_NETWORK=npm
DEVLAUNCH_CONTAINER_NAME=devlaunch-frontend

# Local macOS companion agent
DEVLAUNCH_AGENT_PORT=47821
DEVLAUNCH_PROJECTS_ROOT="${HOME}/projects"
DEVLAUNCH_DATABASE_PATH="${HOME}/Library/Application Support/DevLaunch/devlaunch.sqlite"

# Optional: enables Nginx Proxy Manager route discovery in the dashboard.
DEVLAUNCH_NPM_DB="${HOME}/projects/nginx-proxy-manager/data/database.sqlite"
