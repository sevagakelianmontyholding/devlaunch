{
  "name": "devlaunch",
  "version": "1.0.0",
  "private": true,
  "description": "Local developer command center for macOS: projects, Docker, Git, and one-click SSH deployments.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname ${DEVLAUNCH_BIND:-127.0.0.1} --port ${DEVLAUNCH_PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "splash": "node scripts/splash.mjs",
    "notifier": "node scripts/notifier.mjs",
    "service:install": "node scripts/notifier.mjs && node scripts/service.mjs install",
    "service:uninstall": "node scripts/service.mjs uninstall"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
